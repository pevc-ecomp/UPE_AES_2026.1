# ═══════════════════════════════════════════════════════
# Copie este arquivo para .env e ajuste os valores
# cp .env.example .env
# ═══════════════════════════════════════════════════════

# ── LLM ──────────────────────────────────────────────
OLLAMA_HOST=http://ollama:11434
OLLAMA_MODEL_PRIMARY=phi3:mini
OLLAMA_MODEL_FALLBACK=llama3.2:1b

# ── Vector Store ──────────────────────────────────────
CHROMA_HOST=http://chroma:8000
CHROMA_COLLECTION=useful_articles

# ── Banco de dados ─────────────────────────────────────
DATABASE_URL=sqlite:////app/data/research.db

# ── APIs externas (chaves opcionais) ──────────────────
# Sem chave: limites padrão de cada API
# Com chave: limites maiores
SEMANTIC_SCHOLAR_API_KEY=
NCBI_API_KEY=

# ── Pipeline de análise ───────────────────────────────
SIMILARITY_THRESHOLD_LOW=0.35
SIMILARITY_THRESHOLD_HIGH=0.60

# ── App ───────────────────────────────────────────────
BACKEND_URL=http://backend:8000
LOG_LEVEL=INFO
