FROM python:3.12-slim

WORKDIR /app

# ── Dependências do sistema ───────────────────────────────────────────────────
RUN apt-get update && apt-get install -y \
    curl \
    && rm -rf /var/lib/apt/lists/*

# ── uv (gerenciador de pacotes rápido) ───────────────────────────────────────
RUN pip install --no-cache-dir uv

# ── Dependências Python ───────────────────────────────────────────────────────
COPY requirements.frontend.txt .
RUN uv pip install --system --no-cache -r requirements.frontend.txt

# ── Código da aplicação ───────────────────────────────────────────────────────
COPY ./frontend ./frontend

# Streamlit procura .streamlit/config.toml no diretório de trabalho (/app),
# não no diretório do script — sem esta cópia o tema/config não é aplicado.
COPY ./frontend/.streamlit ./.streamlit

# ── Python path para imports entre páginas ───────────────────────────────────
ENV PYTHONPATH=/app/frontend

EXPOSE 8501

# ── Iniciar Streamlit ─────────────────────────────────────────────────────────
CMD ["streamlit", "run", "frontend/app.py", \
     "--server.address", "0.0.0.0", \
     "--server.port", "8501"]
