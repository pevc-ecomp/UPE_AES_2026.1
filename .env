# ═══════════════════════════════════════════════════════
# Copie este arquivo para .env e ajuste os valores
# cp .env.example .env
# ═══════════════════════════════════════════════════════

# ── LLM ──────────────────────────────────────────────
OLLAMA_HOST=http://ollama:11434
OLLAMA_MODEL_PRIMARY=phi3:mini
OLLAMA_MODEL_FALLBACK=llama3.2:1b

# ── Claude API (agente "article-evaluator-claude") ────
# Chave da API da Anthropic — obrigatória para usar esse agente
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_PRIMARY=claude-sonnet-5
ANTHROPIC_MODEL_FALLBACK=claude-haiku-4-5-20251001
# Modelo barato para a etapa 1 (triagem por título) — 3x mais barato que o Sonnet
ANTHROPIC_MODEL_SCREENING=claude-haiku-4-5

# ── Banco de dados ─────────────────────────────────────
DATABASE_URL=sqlite:////app/data/research.db

# ── APIs externas (chaves opcionais) ──────────────────
# Sem chave: limites padrão de cada API
# Com chave: limites maiores
SEMANTIC_SCHOLAR_API_KEY=
NCBI_API_KEY=

# ── Pipeline de análise ───────────────────────────────
SIMILARITY_THRESHOLD_LOW=0.35
SIMILARITY_THRESHOLD_HIGH=0.60

# ── App ───────────────────────────────────────────────
BACKEND_URL=http://backend:8000
LOG_LEVEL=INFO
