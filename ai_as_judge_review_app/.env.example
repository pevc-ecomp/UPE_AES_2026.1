# Copie este arquivo para .env e preencha os valores reais.

# Use mock para testar sem API externa.
LLM_PROVIDER=mock

# Para usar um LLM real compatível com Chat Completions, altere para:
# LLM_PROVIDER=openai-compatible

# Chave da API do provedor escolhido.
LLM_API_KEY=sua-chave-aqui

# Endpoint compatível com Chat Completions.
LLM_BASE_URL=https://api.openai.com/v1

# Modelo usado como Judge.
LLM_MODEL=gpt-4.1-mini
